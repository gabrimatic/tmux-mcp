{
  "name": "@gabrimatic/tmux-mcp",
  "version": "0.2.1",
  "description": "A tmux-backed MCP server that gives AI agents a persistent, human-attachable terminal.",
  "type": "module",
  "bin": {
    "tmux-mcp": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.js",
    "test:e2e": "npm run build && node --test tests/e2e.test.js",
    "lint": "eslint .",
    "check": "npm run typecheck && npm test",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tmux",
    "terminal",
    "agent",
    "codex"
  ],
  "author": "Soroush Yousefpour",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabrimatic/tmux-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/gabrimatic/tmux-mcp/issues"
  },
  "homepage": "https://github.com/gabrimatic/tmux-mcp#readme",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.12.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.2"
  }
}
